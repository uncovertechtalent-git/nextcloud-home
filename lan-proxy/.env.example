# Copy to .env next to docker-compose.yml. No secrets here: the AWS key is in
# ./secrets/aws.env, written by scripts/create-iam-user.sh.

# The name under which the services live: <service>.<LAN_DOMAIN>.
# A domain you own; the names exist only in your own DNS servers.
LAN_DOMAIN=lan.example.org

# The Route 53 hosted zone that holds that domain (the zone ID, not its name).
ROUTE53_ZONE_ID=ZXXXXXXXXXXXXX

# Leave unset for the real Let's Encrypt. For a first test use staging:
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

TZ=UTC
