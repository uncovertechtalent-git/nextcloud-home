# Copy to /etc/nextcloud-home/backup.env (root-owned, mode 600). No secrets here,
# but it names the machines.

# The folder with docker-compose.yml, .env, data/ and secrets/.
STACK_DIR=/path/to/services/nextcloud

# ssh user and host of the NAS, and the folder on it that receives the backup.
# By default the user needs passwordless sudo on the NAS: the files are written
# as root so that only root can read them. Better: a dedicated NAS user that owns
# NAS_DIR (mode 700) and has no sudo; then set NAS_SUDO to empty, below.
NAS_TARGET=backup-user@nas-address
NAS_DIR=/volume1/Backups/nextcloud-home

# NAS_SUDO=

# Private key the job logs in with, and the known_hosts file that already
# holds the NAS host key (log in once by hand to add it).
SSH_KEY=/path/to/.ssh/backup-key
KNOWN_HOSTS=/path/to/.ssh/known_hosts

# How many database dumps and config archives to keep (one per night), and
# how many weekly generations of data archives (a full archive plus its
# incrementals).
KEEP=28
KEEP_GENERATIONS=4

# Where this machine keeps the state of the incremental chain.
# STATE_DIR=/var/lib/nextcloud-backup
