[Unit]
Description=Nextcloud backup to the NAS
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nextcloud-backup
# A first run over a big data directory can take many hours. A hung ssh
# connection is cut by the ServerAlive settings in the script, not by this.
TimeoutStartSec=24h
Nice=10
IOSchedulingClass=idle
