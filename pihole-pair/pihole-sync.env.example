# Copy to /etc/pihole-sync/sync.env on the SECONDARY Pi-hole. No secrets here.

# Web API of the primary (read only: the script sends it GET requests only)
# and of the secondary (this machine; use its web port).
PRIMARY_URL=http://primary-pihole-address/api
SECONDARY_URL=http://localhost:8053/api

# Only if a password is set on that Pi-hole: a file with the password (or an app
# password), readable by root. Leave out when there is none.
# PRIMARY_PASSWORD_FILE=/etc/pihole-sync/primary-password
# SECONDARY_PASSWORD_FILE=/etc/pihole-sync/secondary-password
