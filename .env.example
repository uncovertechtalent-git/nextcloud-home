# Copy to .env next to docker-compose.yml. There are no secrets in this file.

# Host port for the web interface. Pick one that ss -ltn shows as free.
NC_PORT=8380

# Address the port is bound to. 0.0.0.0 covers the LAN interface and the
# tailnet interface together. No router port forward points at it.
NC_BIND_ADDRESS=0.0.0.0

# Hosts that may reach the login page, separated by spaces: the LAN address of
# this machine, its tailnet address, and its MagicDNS name if you use one.
# Replace all three words: whatever stands here is installed as is, and only
# occ can change it afterwards. Used at first install only (see README.md).
NC_TRUSTED_DOMAINS="lan-address tailnet-address magicdns-name"

# http while there is no TLS. https once a TLS front end serves Nextcloud.
NC_PROTOCOL=http

# Behind the reverse proxy in lan-proxy/ (leave commented out without one):
# the name it serves, the same as a URL, and the address under which the proxy
# reaches Nextcloud (with Caddy on the same machine that is the gateway of the
# compose network: docker network inspect nextcloud_default).
# Also add the name to trusted_domains (README.md, "Behind a reverse proxy").
# NC_OVERWRITE_HOST=nextcloud.lan.example.org
# NC_OVERWRITE_CLI_URL=https://nextcloud.lan.example.org
# NC_TRUSTED_PROXIES=proxy-address-as-nextcloud-sees-it

TZ=Europe/Berlin
